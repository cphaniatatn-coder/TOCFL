{"第1級": [{"id": 1, "g": "繫動詞", "ji": "第1級", "ex": "我是學生。"}, {"id": 2, "g": "表所有「的」", "ji": "第1級", "ex": "這是爸爸的鞋子。"}, {"id": 3, "g": "「的」省略用法", "ji": "第1級", "ex": "我_媽媽。"}, {"id": 4, "g": "不", "ji": "第1級", "ex": "A：你是學生嗎？B：我不是（學生）。"}, {"id": 5, "g": "這/那/哪", "ji": "第1級", "ex": "1. 這是什麼？2. 那是誰？3. 你是哪國人？"}, {"id": 6, "g": "什麼", "ji": "第1級", "ex": "你愛吃什麼？這是什麼？"}, {"id": 7, "g": "嗎", "ji": "第1級", "ex": "你喜歡喝咖啡嗎？"}, {"id": 8, "g": "在1", "ji": "第1*級", "ex": "他在學校。"}, {"id": 9, "g": "地點表達", "ji": "第1*級", "ex": "臺灣臺中中山北路123號"}, {"id": 10, "g": "時間表達", "ji": "第1*級", "ex": "他的生日是一九九五年六月十三日。現在是下午兩點三十分。"}, {"id": 11, "g": "稱數法 ", "ji": "第1*級", "ex": "2二  39三十九  108 一百零八  110 一百一（十）1,000 一千1,018 一千零一十八10,000 一萬10,890 一萬零八百九十"}, {"id": 12, "g": "數+量", "ji": "第1*級", "ex": "一本書 一個人"}, {"id": 13, "g": "誰", "ji": "第1*級", "ex": "你喜歡誰？誰在教室？"}, {"id": 14, "g": "哪（裡/兒）", "ji": "第1*級", "ex": "郵局在哪（裡/兒）？"}, {"id": 15, "g": "A-not-A", "ji": "第1*級", "ex": "你喜歡不喜歡喝咖啡？"}], "第2級": [{"id": 16, "g": "Vs（的）N", "ji": "第2級", "ex": "這是一部很好看的電影。"}, {"id": 17, "g": "V了1", "ji": "第2級", "ex": "我昨天買了很多書。"}, {"id": 18, "g": "和1", "ji": "第2級", "ex": "這間餐廳的點心很棒，大人和小孩都喜歡。"}, {"id": 19, "g": "沒（有）1", "ji": "第2級", "ex": "圖書館附近沒有公園。我沒錢。"}, {"id": 20, "g": "會1", "ji": "第2級", "ex": "你今年會出國嗎？"}, {"id": 21, "g": "V著1", "ji": "第2級", "ex": "他戴著帽子。"}, {"id": 22, "g": "序數", "ji": "第2級", "ex": "這是我第一次來臺灣。"}, {"id": 23, "g": "如果", "ji": "第2級", "ex": "如果下雨，我就不出門。"}, {"id": 24, "g": "可以1", "ji": "第2級", "ex": "上課不可以吃東西。"}, {"id": 25, "g": "要2", "ji": "第2級", "ex": "你要記得打電話給王老師。"}, {"id": 26, "g": "要3", "ji": "第2級", "ex": "你今天要一起吃飯嗎？"}, {"id": 27, "g": "時量補語", "ji": "第2級", "ex": "他已經來臺灣一個月了。"}, {"id": 28, "g": "但是", "ji": "第2級", "ex": "這個箱子很大，但是裡面的東西很輕。"}, {"id": 29, "g": "能1", "ji": "第2級", "ex": "他的車能坐七個人。"}, {"id": 30, "g": "V過1", "ji": "第2級", "ex": "我看過這部電影。"}, {"id": 31, "g": "就1", "ji": "第2級", "ex": "你回到家就給我打電話。"}, {"id": 32, "g": "「的」後接成分省略", "ji": "第2級", "ex": "A：你喜歡藍色外套還是黑色外套？B：我喜歡藍的。"}, {"id": 33, "g": "會2", "ji": "第2級", "ex": "你會不會開車？"}, {"id": 34, "g": "能2", "ji": "第2級", "ex": "他感冒了，今天不能運動。"}, {"id": 35, "g": "要1", "ji": "第2級", "ex": "我要出去了，你有什麼話快一點說吧。"}, {"id": 36, "g": "賓+被+V", "ji": "第2級", "ex": "盒子被打開了。"}, {"id": 37, "g": "V+Vs", "ji": "第2級", "ex": "你吃飽了嗎？"}, {"id": 38, "g": "跟2", "ji": "第2級", "ex": "他跟我說了一個很有意思的故事。"}, {"id": 39, "g": "想", "ji": "第2級", "ex": "妹妹想吃冰淇淋。"}, {"id": 40, "g": "和2", "ji": "第2級", "ex": "妹妹很喜歡和爸爸聊天。"}, {"id": 41, "g": "從1", "ji": "第2級", "ex": "我從法國來。"}, {"id": 42, "g": "用", "ji": "第2級", "ex": "他會用筷子吃飯。"}, {"id": 43, "g": "在2/正在V", "ji": "第2級", "ex": "學生在踢足球。媽媽正在包餃子。"}, {"id": 44, "g": "呢1", "ji": "第2級", "ex": "他是德國人，你呢？"}, {"id": 45, "g": "（雖然），可是", "ji": "第2級", "ex": "雖然他不是很有錢，可是他很快樂。我想出國玩，可是錢不夠。"}, {"id": 46, "g": "N+們", "ji": "第2級", "ex": "孩子們都在外面玩。"}, {"id": 47, "g": "開始V", "ji": "第2級", "ex": "我們十點開始上課。"}, {"id": 48, "g": "怎麼", "ji": "第2級", "ex": "從這裡到車站怎麼走？"}, {"id": 49, "g": "可以2", "ji": "第2級", "ex": "你可以看懂中文菜單嗎？"}, {"id": 50, "g": "為什麼", "ji": "第2級", "ex": "你為什麼吃不下飯？"}, {"id": 51, "g": "給", "ji": "第2級", "ex": "他給我一本書。"}, {"id": 52, "g": "V見", "ji": "第2級", "ex": "我看見李明華的腳踏車在樓下。"}, {"id": 53, "g": "V了2", "ji": "第2級", "ex": "天氣變了。天氣冷了。"}, {"id": 54, "g": "（請）不要", "ji": "第2級", "ex": "請不要說話！"}, {"id": 55, "g": "數字+幾", "ji": "第2級", "ex": "這條路上有十幾間餐廳。"}, {"id": 56, "g": "請", "ji": "第2級", "ex": "請你走過來。"}, {"id": 57, "g": "V得+補語", "ji": "第2級", "ex": "王美美的中文字寫得很漂亮。衣服洗得很乾淨。"}, {"id": 58, "g": "幫", "ji": "第2級", "ex": "你可以幫我去郵局寄信嗎？"}, {"id": 59, "g": "以前", "ji": "第2級", "ex": "我以前在醫院工作過。他常常睡覺以前看書。"}, {"id": 60, "g": "V出1", "ji": "第2級", "ex": "王美美一走出餐廳就看見室友。"}, {"id": 61, "g": "多/少", "ji": "第2級", "ex": "你可以多吃一點水果。哥哥應該少喝點啤酒。"}, {"id": 62, "g": "也", "ji": "第2*級", "ex": "他會說中文，也會說日文。"}, {"id": 63, "g": "在3", "ji": "第2*級", "ex": "他在聖誕節的時候去美國。"}, {"id": 64, "g": "以後", "ji": "第2*級", "ex": "吃完早餐以後，他就去上學了。兩個月以後我要去日本。"}, {"id": 65, "g": "怎麼樣", "ji": "第2*級", "ex": "今天天氣怎麼樣？"}, {"id": 66, "g": "幾/多少1", "ji": "第2*級", "ex": "從臺北到臺中，坐火車要幾個小時？啤酒一罐多少錢？"}, {"id": 67, "g": "怎麼辦", "ji": "第2*級", "ex": "我今天忘了帶錢，怎麼辦？"}, {"id": 68, "g": "跟1", "ji": "第2*級", "ex": "我跟姐姐一起到圖書館借書。"}, {"id": 69, "g": "請問", "ji": "第2*級", "ex": "請問你叫什麼名字？"}, {"id": 70, "g": "好嗎", "ji": "第2*級", "ex": "請你再說一次，好嗎？"}, {"id": 71, "g": "怎麼了", "ji": "第2*級", "ex": "李明華今天沒來上班，他怎麼了？"}, {"id": 72, "g": "V到2/在", "ji": "第2*級", "ex": "阿姨走到對面的超市去買菜。叔叔一直住在臺北。"}, {"id": 73, "g": "從......到......1", "ji": "第2*級", "ex": "這間公司的上班時間是從早上八點到下午五點。"}, {"id": 74, "g": "從......到......2", "ji": "第2*級", "ex": "從臺北到南投開車要三個半小時。"}, {"id": 75, "g": "都1", "ji": "第2*級", "ex": "我們都喜歡慢跑。"}, {"id": 76, "g": "V來/去1", "ji": "第2*級", "ex": "你的東西我拿來了。他跑去學校了。"}, {"id": 77, "g": "因為......所以......", "ji": "第2*級", "ex": "因為他們沒有錢，所以不能出國旅行。"}, {"id": 78, "g": "有的......有的......", "ji": "第2*級", "ex": "班上的同學有的會說英文，有的會說法文。"}, {"id": 79, "g": "到......（去/來）+VP", "ji": "第2*級", "ex": "你要到哪裡去旅行？他們到臺灣學中文。"}, {"id": 80, "g": "太Vs了", "ji": "第2*級", "ex": "這家飯店太貴了，我不要住。"}, {"id": 81, "g": "......還是......", "ji": "第2*級", "ex": "爸爸今天晚上想吃飯還是吃麵？"}, {"id": 82, "g": "又......又......", "ji": "第2*級", "ex": "這家餐廳又便宜又有名。"}, {"id": 83, "g": "有（一）點Vs", "ji": "第2*級", "ex": "我有一點累。今天有一點冷。"}, {"id": 84, "g": "（在） PW 的 N", "ji": "第2*級", "ex": "在桌上的電腦是我弟弟的。"}, {"id": 85, "g": "從2", "ji": "第2*級", "ex": "從早上開始，郵局排隊的人就很多。"}, {"id": 86, "g": "V起來1", "ji": "第2*級", "ex": "他站起來走出房間。"}, {"id": 87, "g": "Vs一點", "ji": "第2*級", "ex": "搬家的時候要小心一點。"}, {"id": 88, "g": "數詞+多（量詞）", "ji": "第2*級", "ex": "他們聊天聊了一個多小時。"}, {"id": 89, "g": "V到1", "ji": "第2*級", "ex": "王美美今天上課上到下午五點。"}, {"id": 90, "g": "又1", "ji": "第2*級", "ex": "他又忘了寫功課。"}, {"id": 91, "g": "又2", "ji": "第2*級", "ex": "他去了臺中，又去了高雄。他買了一件衣服，又買了一條褲子。"}, {"id": 92, "g": "V過來1/過去", "ji": "第2*級", "ex": "小孩笑著向我跑過來。我在這邊停車，你可以先走過去找朋友。"}, {"id": 93, "g": "V下來/下去1", "ji": "第2*級", "ex": "大家到了可以找地方坐下來休息。你可以從10樓走下去嗎？"}, {"id": 94, "g": "A比B ......", "ji": "第2*級", "ex": "弟弟比哥哥高。"}, {"id": 95, "g": "A跟B一樣......", "ji": "第2*級", "ex": "這本書跟那本書一樣貴。"}, {"id": 96, "g": "一......就......", "ji": "第2*級", "ex": "他們一下課就回家。"}, {"id": 97, "g": "（是）......的", "ji": "第2*級", "ex": "我是從美國來的。"}, {"id": 98, "g": "好/難+V", "ji": "第2*級", "ex": "這個字很難寫。三明治很好做。"}, {"id": 99, "g": "了......就......", "ji": "第2*級", "ex": "我吃了早飯就去上課。"}, {"id": 100, "g": "從......往......", "ji": "第2*級", "ex": "從學校往圖書館走就到了。"}, {"id": 101, "g": "A離B......", "ji": "第2*級", "ex": "我家離學校走路只要十分鐘。"}, {"id": 102, "g": "VP 的 N", "ji": "第2*級", "ex": "我認識一位會說德文的英文老師。"}, {"id": 103, "g": "多+Vs？", "ji": "第2*級", "ex": "你哥哥多高？"}, {"id": 104, "g": "V進/出/上/回+（......）來/去", "ji": "第2*級", "ex": "電梯等太久了，我從二樓走上來。你可以從這條路走上去就到了。你說的書我買回來了。照片洗好了，你可以拿回去了。衣服拿進來吧，外面好像快下雨了。我帶回了一個禮物（來）。他走進去書店，買了三本書。李明華走進郵局寄信（去）。弟弟從教室跑出來。老師說先休息十分鐘，大家就跑出去玩了。"}, {"id": 105, "g": "零代詞", "ji": "第2*級", "ex": "他看了菜單後，決定點一份三明治。"}, {"id": 106, "g": "概數", "ji": "第2*級", "ex": "A：你吃了幾個餃子？B：十幾個。"}, {"id": 107, "g": "話題優先", "ji": "第2*級", "ex": "筆，幾塊錢一枝呢？"}], "第3級": [{"id": 108, "g": "V過2", "ji": "第3級", "ex": "我今天早上已經看過電視新聞了。"}, {"id": 109, "g": "V著2", "ji": "第3級", "ex": "他們吃著餅乾看電視。"}, {"id": 110, "g": "V到3", "ji": "第3級", "ex": "他找到那家超市了。"}, {"id": 111, "g": "才1", "ji": "第3級", "ex": "他看了報告後才同意醫生的說法。"}, {"id": 112, "g": "才4", "ji": "第3級", "ex": "我上次見到你的時候，你才十一歲。"}, {"id": 113, "g": "讓1", "ji": "第3級", "ex": "睡前喝杯熱牛奶，可以讓我睡得更好。"}, {"id": 114, "g": "讓2", "ji": "第3級", "ex": "能不能讓我在這兒坐著休息一下？"}, {"id": 115, "g": "叫1", "ji": "第3級", "ex": "老闆叫我下午跟他一起去開會。"}, {"id": 116, "g": "叫2", "ji": "第3級", "ex": "我叫人去買便當回來。"}, {"id": 117, "g": "呢2", "ji": "第3級", "ex": "你什麼時候可以開始工作呢？"}, {"id": 118, "g": "沒（有）2", "ji": "第3級", "ex": "你們參觀過校園沒有？"}, {"id": 119, "g": "必須", "ji": "第3級", "ex": "這場會議很重要，你必須準時參加。"}, {"id": 120, "g": "到", "ji": "第3級", "ex": "三年級到六年級的同學，下課後都要留下來練習跳舞。"}, {"id": 121, "g": "要是......就......", "ji": "第3級", "ex": "你要是發燒，今天就在家休息吧。"}, {"id": 122, "g": "......的話", "ji": "第3級", "ex": "下雨的話，我就不去了。"}, {"id": 123, "g": "A沒有B（這/那麼）...... ", "ji": "第3級", "ex": "事情沒有你想的那麼嚴重。這盤豆腐吃起來沒有炒麵這麼辣。"}, {"id": 124, "g": "不但......而且......", "ji": "第3級", "ex": "這個故事不但容易了解， 而且很有意思。"}, {"id": 125, "g": "不但......還/也......", "ji": "第3級", "ex": "在超商不但可以買東西還可以寄東西。林先生不但是個好老師，也是一位好父親。"}, {"id": 126, "g": "而且", "ji": "第3級", "ex": "臺灣夏天很熱，而且很濕。"}, {"id": 127, "g": "真Vs", "ji": "第3級", "ex": "那個房子真不錯，而且就在學校附近。"}, {"id": 128, "g": "越......越......", "ji": "第3級", "ex": "颱風來了，雨越下越大。"}, {"id": 129, "g": "越來越......", "ji": "第3級", "ex": "他的中文越來越好了。"}, {"id": 130, "g": "本來", "ji": "第3級", "ex": "我們本來不認識，後來聊了一下就熟了。"}, {"id": 131, "g": "然後", "ji": "第3級", "ex": "我喜歡先吃菜再吃肉，然後才吃飯。"}, {"id": 132, "g": "一邊......一邊......", "ji": "第3級", "ex": "他一邊吃飯一邊看手機。"}, {"id": 133, "g": "先......再......", "ji": "第3級", "ex": "大家先找位子再點菜。"}, {"id": 134, "g": "就要......了", "ji": "第3級", "ex": "下個星期就要開學了。"}, {"id": 135, "g": "快要......了", "ji": "第3級", "ex": "暑假快要結束了。"}, {"id": 136, "g": "V一下", "ji": "第3級", "ex": "我帶你去附近的圖書館參觀一下。"}, {"id": 137, "g": "（當）......的時候", "ji": "第3級", "ex": "他生氣的時候，最好不要跟他開玩笑。"}, {"id": 138, "g": "V上", "ji": "第3級", "ex": "他剛剛又走上樓，不知去拿什麼東西。"}, {"id": 139, "g": "V下", "ji": "第3級", "ex": "他們選了一個離門口最近的位子坐下。"}, {"id": 140, "g": "V起", "ji": "第3級", "ex": "他拿起筆寫下電話和地址。"}, {"id": 141, "g": "V滿", "ji": "第3級", "ex": "公車上站滿了人。"}, {"id": 142, "g": "（也）......也......", "ji": "第3級", "ex": "草莓可以做果汁也可以做蛋糕。這個地點可以做生意也可以租人。"}, {"id": 143, "g": "有時候......有時候......", "ji": "第3級", "ex": "百貨公司的活動有時候是打折，有時候是送禮物。"}, {"id": 144, "g": "對", "ji": "第3級", "ex": "李小姐聽到消息後，開心地對我笑了笑。"}, {"id": 145, "g": "對......有興趣", "ji": "第3級", "ex": "他對畫畫很有興趣，以後想當畫家。"}, {"id": 146, "g": "替", "ji": "第3級", "ex": "你可以替我把禮物包起來嗎？"}, {"id": 147, "g": "為了", "ji": "第3級", "ex": "他為了學中文到臺灣來。為了賺更多錢，他打了好幾份工。"}, {"id": 148, "g": "動詞重疊（ABAB）", "ji": "第3級", "ex": "寒假要去哪裡玩，我們可以一起討論討論。"}, {"id": 149, "g": "狀態動詞重疊做謂語AA/AABB", "ji": "第3級", "ex": "我的室友眼睛大大的，頭髮長長的。他每天都穿得漂漂亮亮的。"}, {"id": 150, "g": "狀態動詞重疊做定語", "ji": "第3級", "ex": "這間店的蛋糕很有名，總在短短的時間內就賣完了。"}, {"id": 151, "g": "狀態動詞重疊做狀語", "ji": "第3級", "ex": "安安靜靜地坐著。好好地休息。"}, {"id": 152, "g": "VV看", "ji": "第3級", "ex": "這個麵包很好吃，你吃吃看。"}, {"id": 153, "g": "還沒（有）", "ji": "第3級", "ex": "我還沒給你剛剛買火車票的錢。我才剛回國，現在還沒有時間跟妹妹見面。"}, {"id": 154, "g": "不太/不很", "ji": "第3級", "ex": "你住的地方不太好找，我花了一點時間才找到。我的位子離老師太遠了，所以聽得不很清楚。"}, {"id": 155, "g": "不用/不必", "ji": "第3級", "ex": "他在外面租了房子，這學期不用再住在學校了。我有一個背包，所以不必帶行李箱。"}, {"id": 156, "g": "是不是+VP", "ji": "第3級", "ex": "你臉色不太好，是不是生病了？"}, {"id": 157, "g": "好不好", "ji": "第3級", "ex": "我們選個地點，開店做生意好不好？"}, {"id": 158, "g": "好+幾/多/些+量詞", "ji": "第3級", "ex": "他很喜歡吃餃子，每次都吃好幾盤。我認識他已經有好多年了。爸爸已經出國好些天了，應該快回來了。"}, {"id": 159, "g": "結構助詞「地」", "ji": "第3級", "ex": "他慢慢地走。"}, {"id": 160, "g": "不知道......", "ji": "第3級", "ex": "不知道明天早上六點能不能起得來。"}, {"id": 161, "g": "那麼", "ji": "第3級", "ex": "如果你不同意，那麼你建議我們該怎麼做呢？"}, {"id": 162, "g": "那", "ji": "第3級", "ex": "A：冰箱裡的東西都可以自己拿來吃。B：謝謝，那我就不客氣了。"}, {"id": 163, "g": "（請）別", "ji": "第3級", "ex": "下了飛機以後，別忘了打個電話。"}, {"id": 164, "g": "（請）+VP", "ji": "第3級", "ex": "去洗手！來這裡排隊！請小心開車！保持安靜！"}, {"id": 165, "g": "還是......吧", "ji": "第3級", "ex": "現在排隊的人太多了，我們還是等一下再來吧！"}, {"id": 166, "g": "應該1", "ji": "第3*級", "ex": "運動後應該把汗擦乾。"}, {"id": 167, "g": "應該2", "ji": "第3*級", "ex": "作業應該準時交給老師。"}, {"id": 168, "g": "可以3", "ji": "第3*級", "ex": "游泳可以讓身體更健康。"}, {"id": 169, "g": "V起來2", "ji": "第3*級", "ex": "他一聽到消息就開心地笑起來。"}, {"id": 170, "g": "V起來3", "ji": "第3*級", "ex": "夏天到了，冬天的衣服可以收起來了。"}, {"id": 171, "g": "V下去2", "ji": "第3*級", "ex": "時間到了，我不能再說下去了。"}, {"id": 172, "g": "才2", "ji": "第3*級", "ex": "學語言要多練習，才能學得好。"}, {"id": 173, "g": "才3", "ji": "第3*級", "ex": "他才出門，就開始下雨了。"}, {"id": 174, "g": "就2", "ji": "第3*級", "ex": "這條街有很多銀行，光這個路口就有四家。"}, {"id": 175, "g": "還1", "ji": "第3*級", "ex": "這家餐廳的水比飲料還貴。"}, {"id": 176, "g": "願意", "ji": "第3*級", "ex": "如果有適合的工作，你願意接受嗎？"}, {"id": 177, "g": "只要......就......", "ji": "第3*級", "ex": "他只要有空，就會去參加這次的派對。"}, {"id": 178, "g": "只有......才......", "ji": "第3*級", "ex": "你只有在學中文的環境才學得好。"}, {"id": 179, "g": "只好", "ji": "第3*級", "ex": "外面下起了大雨，我們只好留在飯店裡。"}, {"id": 180, "g": "不管......都......", "ji": "第3*級", "ex": "如果你有問題 ，不管什麼時候都可以打電話給我。"}, {"id": 181, "g": "一M比一M......", "ji": "第3*級", "ex": "秋天到了，天氣開始一天比一天冷。"}, {"id": 182, "g": "Vs得多", "ji": "第3*級", "ex": "他哥哥的年紀比他大得多。"}, {"id": 183, "g": "尤其（是）", "ji": "第3*級", "ex": "百貨公司常常有很多人，尤其是週末和假日。"}, {"id": 184, "g": "V 得/不 了", "ji": "第3*級", "ex": "這麼多東西你拿得了嗎？我一個人吃不了40個餃子。"}, {"id": 185, "g": "V得/不......（表可能）", "ji": "第3*級", "ex": "他看得懂中文菜單。我今天看不完這本書。"}, {"id": 186, "g": "V 得/不 下", "ji": "第3*級", "ex": "這個房間放得下沙發嗎？我的書包放不下這麼多書。"}, {"id": 187, "g": "疑問代詞 ", "ji": "第3*級", "ex": "這裡有很多位子，你想坐在哪裡都可以。"}, {"id": 188, "g": "差不多", "ji": "第3*級", "ex": "我們派對可以開始了，客人差不多都到了。"}, {"id": 189, "g": "Vs極了/得不得了/得很", "ji": "第3*級", "ex": "他終於買到演唱會的門票，心裡高興極了。這間店的空間雖然不大，但是每天生意都好得不得了。這個香蕉蛋糕的作法簡單得很。"}, {"id": 190, "g": "Vs死了", "ji": "第3*級", "ex": "學校裡的功課忙死了，下課還要去打工。"}, {"id": 191, "g": "Vs壞了", "ji": "第3*級", "ex": "他忙了一整天都沒吃東西，肚子餓壞了。"}, {"id": 192, "g": "Vs了一點", "ji": "第3*級", "ex": "雖然排隊的人多了一點，但這間店的牛肉麵非常有名。"}, {"id": 193, "g": "把O V（一）V", "ji": "第3*級", "ex": "今天天氣不錯，記得出門前把衣服洗一洗。"}, {"id": 194, "g": "把 O V到......（來/去）", "ji": "第3*級", "ex": "請你把車開到停車場。媽媽把傘送到學校來。弟弟把大衣拿到洗衣店去。"}, {"id": 195, "g": "把 O V 了", "ji": "第3*級", "ex": "這件衣服穿不下，我打算把它賣了。"}, {"id": 196, "g": "把......V+結果補語", "ji": "第3*級", "ex": "他把菜洗好了。"}, {"id": 197, "g": "把 O V-在 PW", "ji": "第3*級", "ex": "我把書放在桌子上。"}, {"id": 198, "g": "把+N1+V給+N2", "ji": "第3*級", "ex": "回家後再麻煩你把郵件寄給我。"}, {"id": 199, "g": "被+（N）+V得", "ji": "第3*級", "ex": "鄰居的聲音太大了，妹妹被吵得睡不著。"}, {"id": 200, "g": "其實", "ji": "第3*級", "ex": "一個禮拜運動兩次，其實不難。"}, {"id": 201, "g": "什麼都......就是......", "ji": "第3*級", "ex": "他什麼都吃，就是不敢吃臭豆腐。"}, {"id": 202, "g": "V好", "ji": "第3*級", "ex": "颱風快來了，媽媽把食物跟水都先買好了。"}, {"id": 203, "g": "V完", "ji": "第3*級", "ex": "他剛去市場買完菜。"}, {"id": 204, "g": "VP+VP(連動)", "ji": "第3*級", "ex": "我要回家吃飯了。"}, {"id": 205, "g": "才......就......", "ji": "第3*級", "ex": "我跟他才談沒多久，他就有事先離開了。"}, {"id": 206, "g": "時段+否定", "ji": "第3*級", "ex": "他兩天沒睡覺了，讓他多睡一點。"}, {"id": 207, "g": "從......起", "ji": "第3*級", "ex": "從現在起，你應該多吃菜少吃肉。"}, {"id": 208, "g": "V  得/不 起", "ji": "第3*級", "ex": "這支手錶現在在打折，一般學生也買得起。"}, {"id": 209, "g": "V （得/不）出來", "ji": "第3*級", "ex": "從他說話的樣子來看，感覺不出來他很緊張。"}, {"id": 210, "g": "V住", "ji": "第3*級", "ex": "姐姐學一遍，就記住所有作法了。"}, {"id": 211, "g": "V著（ㄓㄠˊ）", "ji": "第3*級", "ex": "他喝完牛奶很快就睡著了。"}, {"id": 212, "g": "V 得/不 動", "ji": "第3*級", "ex": "你拿得動這些書架嗎？"}, {"id": 213, "g": "V慣", "ji": "第3*級", "ex": "他已經過慣了城市的生活，去鄉下常覺得不習慣。"}, {"id": 214, "g": "V掉", "ji": "第3*級", "ex": "今天生意很好，一下子就賣掉了四雙皮鞋。"}, {"id": 215, "g": "V個不停/沒完", "ji": "第3*級", "ex": "他很喜歡跳舞，每次聽到音樂就跳個不停。他對旅遊很有興趣，每次一講都講個沒完。"}, {"id": 216, "g": "V個夠", "ji": "第3*級", "ex": "這次演唱會一共有三十首歌，你可以一次聽個夠。"}, {"id": 217, "g": "PW+V（存現）", "ji": "第3*級", "ex": "餐桌上放著很多新鮮的水果。"}, {"id": 218, "g": "會......的", "ji": "第3*級", "ex": "長大後，人的想法是會改變的。"}, {"id": 219, "g": "（連）....../一......都/也+不/沒......", "ji": "第3*級", "ex": "我連家旁邊開了一間健身房都不知道。畢業後，我們一次也沒見過。"}, {"id": 220, "g": "不是......就是......", "ji": "第3*級", "ex": "他週末不是打籃球，就是去慢跑。"}, {"id": 221, "g": "V（了）（一）V", "ji": "第3*級", "ex": "王小姐高興地笑了笑。"}, {"id": 222, "g": "一M一M ......", "ji": "第3*級", "ex": "他們一步一步爬上去。"}, {"id": 223, "g": "不再......了", "ji": "第3*級", "ex": "找到工作後，他現在不再擔心錢的問題了。"}, {"id": 224, "g": "一點也/都+不/沒", "ji": "第3*級", "ex": "年輕時，整晚不睡一點都不累。我昨晚一點酒也沒喝。"}, {"id": 225, "g": "從來+不/沒......", "ji": "第3*級", "ex": "李明華從來沒搭過飛機。"}, {"id": 226, "g": "不/沒+嗎", "ji": "第3*級", "ex": "你今天怎麼那麼早就回家了，你不舒服嗎？你怎麼站在外面，你沒帶鑰匙嗎？"}, {"id": 227, "g": "不是/沒......嗎", "ji": "第3*級", "ex": "如果參加活動可以認識更多人，這樣不是很好嗎？你怎麼還在家裡，王美美沒跟你說改時間了嗎？"}, {"id": 228, "g": "......QW......就......QW......", "ji": "第3*級", "ex": "這次作文沒有題目，你想寫什麼就寫什麼。"}, {"id": 229, "g": "其中", "ji": "第3*級", "ex": "他們兩兄弟，其中一個適合做生意，一個適合教書。"}, {"id": 230, "g": "等/等等", "ji": "第3*級", "ex": "他很喜歡吃甜食，像是巧克力、蛋糕、冰淇淋等。"}, {"id": 231, "g": "以+上/下/內/外", "ji": "第3*級", "ex": "他每天通車要花費兩個小時以上。在臺灣，十八歲以下不能買酒。妳可以選一個一千元以內的禮物。他摔到五公尺以外的草地。"}, {"id": 232, "g": "除了......（以外），......都......", "ji": "第3*級", "ex": "除了牛肉以外，其他的肉我都可以吃。"}, {"id": 233, "g": "除了......以外， 還/也......", "ji": "第3*級", "ex": "這次的活動除了杯子以外，還送毛巾。除了我以外，還有十幾位同學也收到了一樣的郵件。"}, {"id": 234, "g": "數+（量詞）+左右", "ji": "第3*級", "ex": "他每天搭車上班的時間需要一個小時左右。"}, {"id": 235, "g": "百分數", "ji": "第3*級", "ex": "這裡只有百分之五的人沒出過國。"}, {"id": 236, "g": "倍數", "ji": "第3*級", "ex": "姐姐的行李是我的兩倍重。"}, {"id": 237, "g": "分數", "ji": "第3*級", "ex": "這條腳踏車步道他大概只騎了三分之一。"}, {"id": 238, "g": "四則運算", "ji": "第3*級", "ex": "1+2=3 一加二等於三3-2=1 三減二等於一3×2=6 三乘以二等於六8÷4=2 八除以四等於二"}, {"id": 239, "g": "小數點", "ji": "第3*級", "ex": "3.254 三點二五四"}, {"id": 240, "g": "VP/S+的......", "ji": "第3*級", "ex": "這本書討論的是美洲的歷史。"}, {"id": 241, "g": "別（再）......了", "ji": "第3*級", "ex": "別再說話了，比賽要開始囉！"}]}